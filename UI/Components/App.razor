<!DOCTYPE html>
@inject NavigationManager NavigationManager
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content="MASS is a shared writing space for creating stories, inviting collaborators, and building a narrative one voice at a time." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MASS" />
    <meta property="og:title" content="MASS — stories, written together" />
    <meta property="og:description" content="A shared writing space for creating stories, inviting collaborators, and building a narrative one voice at a time." />
    <meta property="og:url" content="@NavigationManager.BaseUri" />
    <meta property="og:image" content="@($"{NavigationManager.BaseUri}images/writers.jpg")" />
    <meta property="og:image:alt" content="Ink illustration of books and writing tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="MASS — stories, written together" />
    <meta name="twitter:description" content="A shared writing space for creating stories, inviting collaborators, and building a narrative one voice at a time." />
    <meta name="twitter:image" content="@($"{NavigationManager.BaseUri}images/writers.jpg")" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["mass.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]" type="module"></script>
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["toast.js"]"></script>
</body>

</html>
